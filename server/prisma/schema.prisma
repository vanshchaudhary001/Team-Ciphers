datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id              String           @id @default(uuid())
  name            String
  emailDomain     String           @unique
  industry        String
  defaultLocation String
  timezone        String           @default("UTC")
  logoUrl         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  users           User[]
  departments     Department[]
  locations       Location[]
  roles           Role[]
  ownerGroups     OwnerGroup[]
  templates       JourneyTemplate[]
  journeys        Journey[]
  employeeProfiles EmployeeProfile[]
  knowledgeSources KnowledgeSource[]
  knowledgeGaps   KnowledgeGap[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  humanHelpRequests HumanHelpRequest[]
  blockers        Blocker[]
}

model User {
  id              String           @id @default(uuid())
  companyId       String
  email           String           @unique
  passwordHash    String
  name            String
  role            String           // EMPLOYEE, HR_ADMIN, TASK_OWNER, COMPANY_ADMIN, PLATFORM_ADMIN
  avatarUrl       String?
  title           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeProfile EmployeeProfile?
  ownerMemberships OwnerGroupMember[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  assignedTasks   JourneyTask[]    @relation("AssignedUserTasks")
  taskNotes       TaskNote[]
  assignedHelpRequests HumanHelpRequest[] @relation("AssignedHelper")

  @@index([companyId])
  @@index([email])
}

model EmployeeProfile {
  id              String           @id @default(uuid())
  userId          String           @unique
  companyId       String
  departmentId    String?
  locationId      String?
  roleId          String?
  managerName     String?
  managerEmail    String?
  buddyName       String?
  buddyEmail      String?
  workMode        String           @default("HYBRID") // REMOTE, HYBRID, ONSITE
  joiningDate     DateTime
  preJoinStatus   String           @default("READY")  // READY, AT_RISK, BLOCKED

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department      Department?      @relation(fields: [departmentId], references: [id])
  location        Location?        @relation(fields: [locationId], references: [id])
  role            Role?            @relation(fields: [roleId], references: [id])
  journeys        Journey[]
  helpRequests    HumanHelpRequest[]

  @@index([companyId])
}

model Department {
  id              String           @id @default(uuid())
  companyId       String
  name            String
  code            String
  createdAt       DateTime         @default(now())

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeProfiles EmployeeProfile[]
  roles           Role[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Location {
  id              String           @id @default(uuid())
  companyId       String
  name            String
  timezone        String           @default("Asia/Kolkata")
  isRemote        Boolean          @default(false)
  createdAt       DateTime         @default(now())

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeProfiles EmployeeProfile[]

  @@index([companyId])
}

model Role {
  id              String           @id @default(uuid())
  companyId       String
  departmentId    String
  title           String
  createdAt       DateTime         @default(now())

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employeeProfiles EmployeeProfile[]
  templates       JourneyTemplate[]

  @@index([companyId])
}

model OwnerGroup {
  id              String           @id @default(uuid())
  companyId       String
  name            String
  code            String           // IT_OPS, HR_OPS, SECURITY, FACILITIES, ENGINEERING
  description     String?
  createdAt       DateTime         @default(now())

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members         OwnerGroupMember[]
  taskTemplates   TaskTemplate[]
  journeyTasks    JourneyTask[]
  blockers        Blocker[]

  @@unique([companyId, code])
  @@index([companyId])
}

model OwnerGroupMember {
  id              String           @id @default(uuid())
  ownerGroupId    String
  userId          String
  isBackup        Boolean          @default(false)
  createdAt       DateTime         @default(now())

  ownerGroup      OwnerGroup       @relation(fields: [ownerGroupId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ownerGroupId, userId])
}

model JourneyTemplate {
  id              String           @id @default(uuid())
  companyId       String
  name            String
  description     String?
  roleId          String?
  version         Int              @default(1)
  isPublished     Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role            Role?            @relation(fields: [roleId], references: [id])
  tasks           TaskTemplate[]
  journeys        Journey[]

  @@index([companyId])
}

model TaskTemplate {
  id                  String                   @id @default(uuid())
  templateId          String
  title               String
  description         String?
  purpose             String?
  category            String                   @default("ACCESS") // ACCESS, EQUIPMENT, TRAINING, HR, ORIENTATION
  required            Boolean                  @default(true)
  defaultOwnerGroupId String?
  slaHours            Int                      @default(24)
  dueDaysOffset       Int                      @default(1)
  orderIndex          Int                      @default(0)
  createdAt           DateTime                 @default(now())

  template            JourneyTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  defaultOwnerGroup   OwnerGroup?              @relation(fields: [defaultOwnerGroupId], references: [id])
  dependencies        TaskTemplateDependency[] @relation("TaskDependencies")
  dependents          TaskTemplateDependency[] @relation("TaskPrerequisites")

  @@index([templateId])
}

model TaskTemplateDependency {
  id                  String          @id @default(uuid())
  taskTemplateId      String          // The dependent task
  dependsOnTemplateId String          // The prerequisite task

  taskTemplate        TaskTemplate    @relation("TaskDependencies", fields: [taskTemplateId], references: [id], onDelete: Cascade)
  dependsOnTemplate   TaskTemplate    @relation("TaskPrerequisites", fields: [dependsOnTemplateId], references: [id], onDelete: Cascade)

  @@unique([taskTemplateId, dependsOnTemplateId])
}

model Journey {
  id                String                 @id @default(uuid())
  companyId         String
  employeeProfileId String
  templateId        String?
  name              String
  health            String                 @default("FLOWING") // FLOWING, DETOURING, STALLED
  startDate         DateTime               @default(now())
  targetDate        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  company           Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeProfile   EmployeeProfile        @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  template          JourneyTemplate?       @relation(fields: [templateId], references: [id])
  tasks             JourneyTask[]
  blockers          Blocker[]

  @@index([companyId])
  @@index([employeeProfileId])
}

model JourneyTask {
  id                    String                  @id @default(uuid())
  journeyId             String
  companyId             String
  title                 String
  purpose               String?
  instructions          String?
  category              String                  @default("ACCESS") // ACCESS, EQUIPMENT, TRAINING, HR, ORIENTATION
  state                 String                  @default("LOCKED") // AVAILABLE, WAITING, LOCKED, DONE
  required              Boolean                 @default(true)
  ownerGroupId          String?
  assignedUserId        String?
  slaHours              Int                     @default(24)
  dueAt                 DateTime?
  completedAt           DateTime?
  completedBy           String?
  stillNotWorkingReason String?
  flaggedAt             DateTime?
  delayReason           String?
  orderIndex            Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  journey               Journey                 @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  ownerGroup            OwnerGroup?             @relation(fields: [ownerGroupId], references: [id])
  assignedUser          User?                   @relation("AssignedUserTasks", fields: [assignedUserId], references: [id])
  dependencies          JourneyTaskDependency[] @relation("JourneyTaskDependencies")
  dependents            JourneyTaskDependency[] @relation("JourneyTaskPrerequisites")
  rootBlockers          Blocker[]               @relation("RootTaskBlockers")
  affectedBlockers      Blocker[]               @relation("AffectedTaskBlockers")
  notes                 TaskNote[]

  @@index([journeyId])
  @@index([companyId])
  @@index([state])
}

model JourneyTaskDependency {
  id              String       @id @default(uuid())
  journeyTaskId   String       // The dependent task (e.g. GitHub Access)
  dependsOnTaskId String       // The prerequisite task (e.g. VPN Approval)

  journeyTask     JourneyTask  @relation("JourneyTaskDependencies", fields: [journeyTaskId], references: [id], onDelete: Cascade)
  dependsOnTask   JourneyTask  @relation("JourneyTaskPrerequisites", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([journeyTaskId, dependsOnTaskId])
}

model Blocker {
  id                     String       @id @default(uuid())
  journeyId              String
  companyId              String
  rootTaskId             String       // Earliest task causing the blockage
  affectedTaskId         String       // Task where employee got stuck
  status                 String       @default("ACTIVE") // ACTIVE, RESOLVED, ESCALATED
  rootCauseSummary       String
  responsibleOwnerGroupId String?
  responsibleUserId      String?
  detectedAt             DateTime     @default(now())
  resolvedAt             DateTime?
  resolutionNote         String?
  nudgedCount            Int          @default(0)
  lastNudgedAt           DateTime?
  escalatedAt            DateTime?

  journey                Journey      @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  company                Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rootTask               JourneyTask  @relation("RootTaskBlockers", fields: [rootTaskId], references: [id], onDelete: Cascade)
  affectedTask           JourneyTask  @relation("AffectedTaskBlockers", fields: [affectedTaskId], references: [id], onDelete: Cascade)
  responsibleOwnerGroup  OwnerGroup?  @relation(fields: [responsibleOwnerGroupId], references: [id])

  @@index([journeyId])
  @@index([companyId])
  @@index([status])
}

model KnowledgeSource {
  id             String       @id @default(uuid())
  companyId      String
  title          String
  excerpt        String
  content        String
  sourceUrl      String?
  category       String       @default("GUIDE") // GUIDE, FAQ, POLICY, RUNBOOK
  departmentId   String?
  roleId         String?
  owner          String       @default("HR Knowledge Team")
  lastReviewedAt DateTime     @default(now())
  status         String       @default("APPROVED") // APPROVED, DRAFT
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([category])
}

model KnowledgeGap {
  id                 String       @id @default(uuid())
  companyId          String
  normalizedQuestion String
  category           String       @default("ACCESS")
  occurrenceCount    Int          @default(1)
  relevantTaskId     String?
  status             String       @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  suggestedOwner     String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  company            Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
}

model Notification {
  id               String       @id @default(uuid())
  companyId        String
  userId           String
  type             String       // TASK_ASSIGNED, TASK_COMPLETED, BLOCKER_DETECTED, TASK_DELAYED, OWNER_NUDGE, SLA_BREACH, REASSIGNMENT, DEPENDENCY_UNLOCKED, HUMAN_HELP_UPDATE
  title            String
  message          String
  relatedTaskId    String?
  relatedBlockerId String?
  isRead           Boolean      @default(false)
  createdAt        DateTime     @default(now())

  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id            String       @id @default(uuid())
  companyId     String
  userId        String?
  action        String       // TASK_COMPLETED, BLOCKER_NUDGED, BLOCKER_ESCALATED, OWNER_APPROVED, TASK_DELAYED, REASSIGNED, UNSTICK_ANALYZED
  entityType    String       // JourneyTask, Blocker, Journey, HumanHelpRequest
  entityId      String
  previousState String?
  newState      String?
  reason        String?
  metadata      String?      // JSON serialized string
  createdAt     DateTime     @default(now())

  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([entityType, entityId])
}

model HumanHelpRequest {
  id                String       @id @default(uuid())
  companyId         String
  employeeProfileId String
  targetType        String       // HR, MANAGER, BUDDY, TEAM
  subject           String
  message           String
  urgency           String       @default("NORMAL") // NORMAL, URGENT
  status            String       @default("OPEN")   // OPEN, IN_PROGRESS, RESOLVED
  response          String?
  assignedToUserId  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  assignedTo        User?        @relation("AssignedHelper", fields: [assignedToUserId], references: [id])

  @@index([companyId])
  @@index([employeeProfileId])
  @@index([status])
}

model TaskNote {
  id            String       @id @default(uuid())
  journeyTaskId String
  userId        String
  authorName    String
  authorRole    String
  note          String
  createdAt     DateTime     @default(now())

  task          JourneyTask  @relation(fields: [journeyTaskId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([journeyTaskId])
}

// ==============================================================
// 5 STRUCTURED DATASETS (DATA-DRIVEN ONBOARDING ENGINE)
// ==============================================================

model DatasetEmployee {
  employeeId   String   @id // e.g. E001
  name         String
  role         String
  department   String
  location     String
  joiningDate  String
  managerId    String?
  buddyId      String?
  email        String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  progress     DatasetProgress[]
}

model DatasetResource {
  resourceId     String   @id // e.g. R001
  resourceName   String
  category       String
  applicableRole String
  department     String
  description    String
  resourceType   String
  link           String
  createdAt      DateTime @default(now())

  tasks          DatasetOnboardingTask[]
}

model DatasetChecklistTemplate {
  checklistId    String   @id // e.g. CHK_001
  checklistName  String
  applicableRole String   // e.g. "Software Engineer", "All"
  department     String   // e.g. "Engineering", "All"
  location       String   // e.g. "Bengaluru", "All"
  durationDays   Int      @default(30)
  createdBy      String   @default("HR Operations")
  status         String   @default("Draft") // Draft, Published, Archived
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tasks          DatasetOnboardingTask[]
}

model DatasetOnboardingTask {
  taskId         String                  @id // e.g. T001
  checklistId    String?                 // FK to checklist_templates
  taskName       String
  applicableRole String
  department     String
  day            String
  priority       String
  assignedBy     String
  deadline       String?
  resourceId     String?
  isMandatory    Boolean                 @default(true)
  orderIndex     Int                     @default(0)
  createdAt      DateTime                @default(now())

  checklist      DatasetChecklistTemplate? @relation(fields: [checklistId], references: [checklistId], onDelete: Cascade)
  resource       DatasetResource?          @relation(fields: [resourceId], references: [resourceId])
  progress       DatasetProgress[]
}

model DatasetContact {
  contactId    String   @id // e.g. C001
  name         String
  team         String
  role         String
  purpose      String
  email        String
  phone        String
  availability String
  escalationTo String?
  createdAt    DateTime @default(now())
}

model DatasetProgress {
  progressId    String                @id // e.g. P001
  employeeId    String
  taskId        String
  status        String                // Pending, In Progress, Completed, Overdue
  assignedDate  String
  dueDate       String?
  completedDate String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  employee      DatasetEmployee       @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  task          DatasetOnboardingTask @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@unique([employeeId, taskId])
  @@index([employeeId])
  @@index([taskId])
}
